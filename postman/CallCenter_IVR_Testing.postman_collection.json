{
  "info": {
    "_postman_id": "b1e6f2b0-4c1a-4a6a-9c1e-7c1f3d5a2b10",
    "name": "CallCenter - Multi-Client IVR Platform",
    "description": "Follows the platform's real story end to end: onboard two independent clients (Apex Bank, Swift Loan Recovery) -> each designs their own flow (typed prompts + optional real audio + a data lookup) -> create a campaign atomically linked to that flow -> watch it pre-synthesize every prompt BEFORE the worker is allowed to dial anyone ('preparing' -> 'running') -> prove neither client can see or touch the other's flow or campaign. Run folders top to bottom - each request's Tests script saves IDs/tokens into collection variables that later requests consume automatically.\n\nNote: the Dinstar SIM gateway may be offline - if so, campaigns still create/prepare/link correctly, they just won't physically ring a phone until the gateway is back online. Everything through the dial attempt can be verified without it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://newcallcenter.onrender.com" },
    { "key": "admin_username", "value": "bootstrap_admin" },
    { "key": "admin_password", "value": "AdminPass123!" },
    { "key": "admin_token", "value": "" },
    { "key": "bank_tenant_name", "value": "Apex Bank" },
    { "key": "bank_subdomain", "value": "apexbank" },
    { "key": "bank_admin_username", "value": "apexbank_admin" },
    { "key": "bank_admin_password", "value": "ApexBank123!" },
    { "key": "bank_admin_token", "value": "" },
    { "key": "bank_tenant_id", "value": "" },
    { "key": "loan_tenant_name", "value": "Swift Loan Recovery" },
    { "key": "loan_subdomain", "value": "swiftloans" },
    { "key": "loan_admin_username", "value": "swiftloans_admin" },
    { "key": "loan_admin_password", "value": "SwiftLoans123!" },
    { "key": "loan_admin_token", "value": "" },
    { "key": "loan_tenant_id", "value": "" },
    { "key": "test_phone_number", "value": "+919999999999" },
    { "key": "test_language_code", "value": "en-US" },
    { "key": "prompt_welcome_audio", "value": "" },
    { "key": "lookup_table_id", "value": "" },
    { "key": "bank_flow_id", "value": "" },
    { "key": "loan_flow_id", "value": "" },
    { "key": "bank_campaign_id", "value": "" },
    { "key": "agent_username", "value": "test_agent_pm" },
    { "key": "agent_password", "value": "AgentTest123!" },
    { "key": "agent_token", "value": "" },
    { "key": "agent_id", "value": "" },
    { "key": "call_id", "value": "" },
    { "key": "gateway_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "0.1 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "No auth required. Confirms the backend is up and shows live postgres/redis/AMI connection status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Backend is healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "    pm.expect(json.connections.postgres).to.eql('connected');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Platform Owner Login (super_admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "This is the ONE account that can onboard new clients (POST /api/auth/clients is super_admin-gated). Every client's own admin, created in folder 1, only ever manages their own tenant from here on."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded, token received', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.collectionVariables.set('admin_token', json.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Onboard Two Independent Clients",
      "item": [
        {
          "name": "1.1 Onboard Client: Apex Bank",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"{{bank_tenant_name}}\",\n  \"subdomain\": \"{{bank_subdomain}}\",\n  \"adminUsername\": \"{{bank_admin_username}}\",\n  \"adminPassword\": \"{{bank_admin_password}}\",\n  \"portNumbers\": [0, 1]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/clients", "host": ["{{baseUrl}}"], "path": ["api", "auth", "clients"] },
            "description": "Creates a brand-new tenant + its first client_admin login + grants them SIM ports 0 and 1, all in ONE atomic request - portNumbers is mandatory, not an optional follow-up step. This is the entire onboarding step for a new business - no code changes, ever, per client. If you've already run this collection before, you'll get a 409 (tenant/username already exists) - that's fine, just continue to 1.3."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client onboarded or already exists', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Onboard Client: Swift Loan Recovery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"{{loan_tenant_name}}\",\n  \"subdomain\": \"{{loan_subdomain}}\",\n  \"adminUsername\": \"{{loan_admin_username}}\",\n  \"adminPassword\": \"{{loan_admin_password}}\",\n  \"portNumbers\": [3, 4]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/clients", "host": ["{{baseUrl}}"], "path": ["api", "auth", "clients"] },
            "description": "A completely different business scenario (loan recovery vs. banking) - same onboarding call, zero code differences. Their tenant_id will be different from Apex Bank's, and their ports (3, 4) are a completely separate pool from Apex Bank's (0, 1) - which is what makes everything below isolated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client onboarded or already exists', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Login as Apex Bank Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{bank_admin_username}}\",\n  \"password\": \"{{bank_admin_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "From here on, {{bank_admin_token}} is used for every Apex Bank request below - it carries their tenant_id in the JWT, which is what every /api/ivr/* and /api/campaigns/* endpoint filters by."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bank admin login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('bank_admin_token', json.token);",
                  "    pm.collectionVariables.set('bank_tenant_id', json.user.tenant_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Login as Swift Loans Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{loan_admin_username}}\",\n  \"password\": \"{{loan_admin_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Loan admin login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('loan_admin_token', json.token);",
                  "    pm.collectionVariables.set('loan_tenant_id', json.user.tenant_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Increase Apex Bank's Ports (0,1 -> 0,1,2)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portNumbers\": [0, 1, 2]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/gateways/tenants/{{bank_tenant_id}}/ports", "host": ["{{baseUrl}}"], "path": ["api", "gateways", "tenants", "{{bank_tenant_id}}", "ports"] },
            "description": "Sets Apex Bank's allocation to EXACTLY this list - adding port 2 on top of the 0,1 they got at onboarding. \"Increase\" and \"decrease\" are the same endpoint, just a longer or shorter portNumbers array. If port 2 is already held by a different tenant from earlier testing, you'll correctly get a 400 - pick a genuinely free port number instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ports increased', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.ports).to.include.members([0, 1, 2]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Decrease Apex Bank's Ports (0,1,2 -> just 0)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portNumbers\": [0]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/gateways/tenants/{{bank_tenant_id}}/ports", "host": ["{{baseUrl}}"], "path": ["api", "gateways", "tenants", "{{bank_tenant_id}}", "ports"] },
            "description": "Same endpoint, shorter list - releases ports 1 and 2 back to the free pool (their tenant_id goes back to null) and leaves Apex Bank with just port 0. Check folder 3's campaign requests afterward to see allowedPorts now defaults to just \"0\"."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ports decreased', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.ports).to.eql([0]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Apex Bank Designs Its Own Flow",
      "item": [
        {
          "name": "2.1 Upload a Real Recorded Prompt (optional path)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "audio", "type": "file", "src": "/home/cell24x7/Downloads/Project/ofc/Outbound_call/outbound_campaign_module/postman/assets/welcome_test.wav" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/ivr/prompts", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "prompts"] },
            "description": "Path 1 of 2 for getting a prompt onto the box: upload a real recording, get back a prompt_id to reference in a node. Transcodes + delivers to the Asterisk box automatically. The flow below uses this for its welcome node, and typed text (path 2) for everything else, to show both working side by side."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prompt uploaded', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.prompt_id).to.be.a('string');",
                  "    pm.collectionVariables.set('prompt_welcome_audio', json.prompt_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Upload Lookup Data (CSV)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "type": "text", "value": "Apex Bank Account Lookup" },
                { "key": "keyColumn", "type": "text", "value": "provider_number" },
                { "key": "csv", "type": "file", "src": "/home/cell24x7/Downloads/Project/ofc/Outbound_call/outbound_campaign_module/postman/assets/providers.csv" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/ivr/lookup-tables", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "lookup-tables"] },
            "description": "Sample CSV (provider_number/provider_name columns) - swap this file for your own client data (account numbers, loan IDs, policy numbers, whatever your lookup node needs to key on) and adjust keyColumn to match your header. This is the 'table' source option for a lookup node; a client with their own backend can point at a webhook instead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Lookup table created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('lookup_table_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Create Flow (typed prompts + uploaded audio + lookup, all in one)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Bank - Account Balance Flow\",\n  \"nodes\": [\n    {\n      \"client_id\": \"welcome\",\n      \"type\": \"play\",\n      \"is_start\": true,\n      \"prompt_id\": \"{{prompt_welcome_audio}}\",\n      \"next\": \"menu\"\n    },\n    {\n      \"client_id\": \"menu\",\n      \"type\": \"menu\",\n      \"prompt_text\": \"Press 1 to check your account balance. Press 9 to end this call.\",\n      \"config\": { \"digit_timeout_ms\": 8000 },\n      \"branches\": { \"1\": \"collect_account\", \"9\": \"hangup_node\" }\n    },\n    {\n      \"client_id\": \"collect_account\",\n      \"type\": \"collect_input\",\n      \"prompt_text\": \"Please enter your ten digit account number, then press the pound key.\",\n      \"config\": { \"max_digits\": 10, \"min_digits\": 10, \"terminator\": \"#\", \"store_as\": \"provider_number\" },\n      \"next\": \"lookup_account\"\n    },\n    {\n      \"client_id\": \"lookup_account\",\n      \"type\": \"lookup\",\n      \"config\": { \"source_type\": \"table\", \"table_id\": \"{{lookup_table_id}}\", \"lookup_key\": \"provider_number\", \"response_var_prefix\": \"provider_\" },\n      \"branches\": { \"found\": \"speak_result\", \"not_found\": \"not_found_node\" }\n    },\n    {\n      \"client_id\": \"speak_result\",\n      \"type\": \"play\",\n      \"prompt_text\": \"Thank you. Your account is registered to {{provider_name}}. Goodbye.\",\n      \"next\": \"hangup_node\"\n    },\n    {\n      \"client_id\": \"not_found_node\",\n      \"type\": \"play\",\n      \"prompt_text\": \"Sorry, we could not find that account number in our records.\",\n      \"next\": \"hangup_node\"\n    },\n    {\n      \"client_id\": \"hangup_node\",\n      \"type\": \"hangup\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ivr/flows", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "flows"] },
            "description": "One flow, demonstrating everything: welcome uses an uploaded recording (prompt_id); menu/collect_account/not_found_node are just TYPED text (prompt_text) - no audio file needed, Piper speaks them; speak_result's prompt_text contains {{'{{'}}provider_name{{'}}'}}, a value that only exists once the lookup runs mid-call - that's a flow VARIABLE, not a Postman variable, leave it exactly as-is. Real DTMF branching (1 -> lookup, 9 -> hangup), a data lookup, and dynamic TTS readback, all client-authored as plain JSON. This is a sample scenario - design your actual flow the same way, with your own content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Flow created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.collectionVariables.set('bank_flow_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Get Flow (verify it saved correctly)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ivr/flows/{{bank_flow_id}}", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "flows", "{{bank_flow_id}}"] },
            "description": "Reads the flow back - confirms all 7 nodes persisted, with client_id references resolved to real database UUIDs, and prompt_text stored alongside prompt_id per node."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Flow has all 7 nodes', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.nodes.length).to.eql(7);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Apex Bank Runs a Campaign",
      "item": [
        {
          "name": "3.1 Create Campaign (atomically linked to the flow)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "type": "text", "value": "Apex Bank Balance Reminders" },
                { "key": "phoneNumbers", "type": "text", "value": "[{\"phoneNumber\": \"{{test_phone_number}}\", \"customerName\": \"Test Customer\", \"languageCode\": \"{{test_language_code}}\"}]" },
                { "key": "ivrFlowId", "type": "text", "value": "{{bank_flow_id}}" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/campaigns/broadcast", "host": ["{{baseUrl}}"], "path": ["api", "campaigns", "broadcast"] },
            "description": "REPLACE {{test_phone_number}} with your own real number if you want this to actually ring you. {{test_language_code}} defaults to en-US - change to hi-IN or mr-IN to test another installed voice, per-lead, with zero flow changes.\n\nivrFlowId links the campaign to the flow in the SAME insert as creation (no separate activate-after-create race). No audio file is required - the flow supplies its own prompts.\n\nResponse status will be \"preparing\" (not \"running\") since this flow has static prompt_text - the backend pre-synthesizes every prompt for every language your leads use BEFORE the worker is allowed to dial anyone. This is what closes the ~20-second dead-air bug that used to happen live on the first call to a never-before-spoken phrase. Move on to 3.2 and poll until it flips."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Campaign created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.campaignId).to.be.a('string');",
                  "    pm.expect(['preparing', 'running']).to.include(json.status);",
                  "    pm.collectionVariables.set('bank_campaign_id', json.campaignId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Poll Until Status = running",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/campaigns/{{bank_campaign_id}}", "host": ["{{baseUrl}}"], "path": ["api", "campaigns", "{{bank_campaign_id}}"] },
            "description": "Click Send repeatedly (every few seconds) until campaign.status reads \"running\" instead of \"preparing\" - that's your signal every prompt for this campaign's language(s) is already sitting on the Asterisk box, so the very first call plays audio instantly instead of going silent for ~20s. While status is \"preparing\", the worker will NOT touch this campaign's leads at all (dial_status stays \"pending\", attempts stays 0) - check the leads array below to see that for yourself.\n\nAlso confirms campaign.ivr_flow_id equals bank_flow_id from step 2.3 - proof the whole chain wired together."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Campaign is linked to the right flow', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.campaign.ivr_flow_id).to.eql(pm.collectionVariables.get('bank_flow_id'));",
                  "    console.log('campaign status:', json.campaign.status, '| lead dial_status:', json.leads[0] ? json.leads[0].dial_status : 'n/a');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 List Campaigns (Apex Bank sees only its own)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/campaigns", "host": ["{{baseUrl}}"], "path": ["api", "campaigns"] },
            "description": "Scoped to the caller's own tenant - only shows campaigns Apex Bank itself created, regardless of how many other clients are running campaigns on the same platform."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Campaign list returned, all belong to this tenant', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Prove Multi-Tenant Isolation",
      "item": [
        {
          "name": "4.1 Swift Loans Creates Its Own (Different) Flow",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{loan_admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Swift Loans - Recovery Flow\",\n  \"nodes\": [\n    {\n      \"client_id\": \"welcome\",\n      \"type\": \"play\",\n      \"is_start\": true,\n      \"prompt_text\": \"This is Swift Loan Recovery calling about your overdue payment. Press 1 to speak with an agent, or 9 to end this call.\",\n      \"next\": \"hangup_node\"\n    },\n    {\n      \"client_id\": \"hangup_node\",\n      \"type\": \"hangup\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ivr/flows", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "flows"] },
            "description": "A completely different business scenario, authored by a completely different client, with zero code changes on the backend. Needed here so the isolation checks below have something real to test against in both directions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Loan recovery flow created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('loan_flow_id', json.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Swift Loans Tries to Read Apex Bank's Flow -> 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{loan_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ivr/flows/{{bank_flow_id}}", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "flows", "{{bank_flow_id}}"] },
            "description": "Every /api/ivr/* read filters WHERE tenant_id = caller's own tenant - a flow belonging to a different tenant isn't 403 Forbidden, it's 404 Not Found, exactly as if it doesn't exist. No information leak either way."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Blocked - flow not found for this tenant', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.3 Apex Bank Tries to Read Swift Loans' Flow -> 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ivr/flows/{{loan_flow_id}}", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "flows", "{{loan_flow_id}}"] },
            "description": "Same check, other direction - confirms isolation isn't one-way."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Blocked - flow not found for this tenant', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.4 Swift Loans Tries to Read Apex Bank's Campaign -> 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{loan_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/campaigns/{{bank_campaign_id}}", "host": ["{{baseUrl}}"], "path": ["api", "campaigns", "{{bank_campaign_id}}"] },
            "description": "Campaigns are scoped the exact same way as flows (Workstream 9) - previously campaign creation was zero-auth and every campaign landed under one shared default tenant regardless of who created it; this proves that's fixed too."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Blocked - campaign not found for this tenant', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.5 Apex Bank Confirms It Can Still Read Its Own Flow -> 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bank_admin_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/ivr/flows/{{bank_flow_id}}", "host": ["{{baseUrl}}"], "path": ["api", "ivr", "flows", "{{bank_flow_id}}"] },
            "description": "The isolation is per-tenant, not a blanket lockout - Apex Bank's own admin still sees everything that belongs to Apex Bank, fully and correctly."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Own flow still fully readable', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('bank_flow_id'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Agent & Calls (optional, Workstream 7)",
      "item": [
        {
          "name": "5.1 Create Test Agent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{agent_username}}\",\n  \"password\": \"{{agent_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/agents", "host": ["{{baseUrl}}"], "path": ["api", "auth", "agents"] },
            "description": "Creates a fresh test agent (rather than reusing the existing seeded agent1) and lazily provisions its SIP endpoint. If this username already exists from a previous run, you'll get a 409 - that's fine, just skip to 5.2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('agent_id', json.agent.id);",
                  "}",
                  "pm.test('Agent created or already exists', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Agent Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{agent_username}}\",\n  \"password\": \"{{agent_password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
