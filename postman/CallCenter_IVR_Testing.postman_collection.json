          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Agent login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('agent_token', json.token);",
                  "    pm.collectionVariables.set('agent_id', json.user.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.3 Get My SIP Credentials",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{agent_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me/sip-credentials", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me", "sip-credentials"] },
            "description": "Returns { sipUsername, sipPassword, wssUrl } for the WebRTC softphone at /agent-softphone/."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('SIP credentials returned', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "5.4 Agent Go Ready",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{agent_token}}" }],
            "url": { "raw": "{{baseUrl}}/api/calls/ready", "host": ["{{baseUrl}}"], "path": ["api", "calls", "ready"] },
            "description": "Moves the agent from 'login' to 'idle' - without this they're never eligible for the campaign_agents queue or inbound ACD."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Agent is idle', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "5.5 Agent Click-to-Dial",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerNumber\": \"{{test_phone_number}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calls/dial", "host": ["{{baseUrl}}"], "path": ["api", "calls", "dial"] },
            "description": "Creates a call record and fires an AMI Originate. With the Dinstar gateway offline this will accept the request but the physical call won't connect - useful to confirm the API/DB path still works."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Call initiated', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('call_id', json.callId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5.6 Submit Disposition",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callId\": \"{{call_id}}\",\n  \"dispositionCode\": \"RESOLVED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/calls/disposition", "host": ["{{baseUrl}}"], "path": ["api", "calls", "disposition"] },
            "description": "NOTE: the `dispositions` table is currently empty for this tenant, so this will 404 with 'Disposition code invalid for this tenant' until you seed one. Run this SQL once (via Render's DB shell or psql) before using this request:\n\nINSERT INTO dispositions (tenant_id, code, label, is_resolved) VALUES ('a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11','RESOLVED','Resolved - Test', true);\n\nThere's no API endpoint for managing dispositions yet - out of scope of the current work, flagging it here so the 404 isn't confusing."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Disposition submitted (see request description if this 404s)', function () { pm.response.to.have.status(200); });"] } }]
        },
        {
          "name": "5.7 Agent Break",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{agent_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"break\",\n  \"breakType\": \"tea\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/calls/break", "host": ["{{baseUrl}}"], "path": ["api", "calls", "break"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Break logged', function () { pm.response.to.have.status(200); });"] } }]
        },
