            "url": { "raw": "{{baseUrl}}/api/calls/bucket", "host": ["{{baseUrl}}"], "path": ["api", "calls", "bucket"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Bucket returned', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
