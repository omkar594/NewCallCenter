PORT=5000
DATABASE_URL=postgres://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_long_random_string

# Asterisk AMI (Asterisk Manager Interface)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=change_me
ASTERISK_AMI_PASS=change_me
# Set to true only for local dev without a real Asterisk box. Never set true in production.
AMI_MOCK_MODE=false
# WebSocket URL agents' softphones (frontend_component/agent_softphone/) register against -
# must match telephony_config/pjsip.conf's [transport-wss] bind port. Defaults to
# wss://<ASTERISK_AMI_HOST>:8089/ws if unset.
ASTERISK_WSS_URL=wss://127.0.0.1:8089/ws
# Asterisk queue (queues.conf) that press-1-to-agent calls join - see Workstream 7.
CAMPAIGN_AGENT_QUEUE=campaign_agents

# Asterisk ARI (Workstream 8 - IVR flow engine). Reuses the same TLS port/cert as
# ASTERISK_WSS_URL above (8089) - confirmed already reachable externally, no separate
# security-group port needed. See ari.conf's [ivr_engine] user block on the EC2 box.
# IMPORTANT: must use the box's cert-matching hostname (its SAN, e.g. an *.sslip.io name for
# the EC2 IP), not the bare IP - confirmed live that a raw-IP URL fails TLS hostname
# verification even though the same box/port answers fine.
ARI_BASE_URL=https://127.0.0.1:8089
ARI_USERNAME=ivr_engine
ARI_PASSWORD=change_me
ARI_APP_NAME=ivr_engine
# Set to true only for local dev without a real Asterisk box. Never set true in production.
ARI_MOCK_MODE=false

# Piper TTS (Workstream 8.9) - offline, local neural TTS, required for any IVR flow
# 'play'/'menu'/etc. node whose prompt_id contains {{variable}} placeholders (e.g. speaking
# back a looked-up provider name or generated booking code). Static, pre-recorded prompts don't
# need this at all. Runs ON the Asterisk box (not Render) over its OWN dedicated SSH credential -
# deliberately separate from ASTERISK_SSH_* above, since that account is SFTP-only (shell is
# nologin) and cannot exec anything. This user must be restricted to running only the Piper
# wrapper (a forced `command=` entry in its authorized_keys), same least-privilege principle as
# campaign-uploader. EC2-side setup (not part of this repo): install Piper, download the .onnx
# voice model(s) you need into PIPER_MODEL_DIR, create this restricted user.
PIPER_SSH_HOST=127.0.0.1
PIPER_SSH_PORT=22
PIPER_SSH_USER=tts-runner
PIPER_SSH_PRIVATE_KEY_PATH=/etc/secrets/piper_deploy_key
PIPER_BIN=piper
PIPER_MODEL_DIR=/opt/piper/models
PIPER_DEFAULT_MODEL=en_IN-model.onnx
# Optional per-language override as a JSON object, e.g.:
# PIPER_VOICE_MODELS={"hi-IN":"hi_IN-model.onnx","mr-IN":"mr_IN-model.onnx"}
PIPER_VOICE_MODELS={}
TTS_DEFAULT_LANGUAGE_CODE=en-IN

# Dinstar GSM gateway
DINSTAR_GATEWAY_IP=192.168.1.186
DINSTAR_API_USER=change_me
DINSTAR_API_PASS=change_me

# Campaign dialer pacing (minimum stagger between originates, seconds)
PACING_BUFFER_DELAY_SEC=2
# How long an ordinary (non-transferred) answered call may hold its concurrency slot, ms.
MAX_CALL_DURATION_MS=300000
# Workstream 7: how long a call TRANSFERRED to a live agent (DTMF 1) may hold its slot, ms -
# must be long enough for a real conversation, unlike MAX_CALL_DURATION_MS above.
MAX_AGENT_CALL_DURATION_MS=7200000
# How many times a lead is retried after an immediate gateway-busy rejection before failing it.
MAX_DIAL_ATTEMPTS=3

# SSH/SCP delivery of transcoded campaign audio to the Asterisk box's sounds directory
ASTERISK_SSH_HOST=127.0.0.1
ASTERISK_SSH_PORT=22
ASTERISK_SSH_USER=campaign-uploader
ASTERISK_SSH_PRIVATE_KEY_PATH=/etc/secrets/asterisk_deploy_key
# campaign-uploader is chrooted to /var/lib/asterisk/sounds (see README deploy runbook),
# so this path is relative to THAT root, not the Asterisk host's real filesystem root.
ASTERISK_SOUNDS_DIR=/campaign_audio

S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
