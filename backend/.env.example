PORT=5000
DATABASE_URL=postgres://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_long_random_string

# Asterisk AMI (Asterisk Manager Interface)
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=change_me
ASTERISK_AMI_PASS=change_me
# Set to true only for local dev without a real Asterisk box. Never set true in production.
AMI_MOCK_MODE=false
# WebSocket URL agents' softphones (frontend_component/agent_softphone/) register against -
# must match telephony_config/pjsip.conf's [transport-wss] bind port. Defaults to
# wss://<ASTERISK_AMI_HOST>:8089/ws if unset.
ASTERISK_WSS_URL=wss://127.0.0.1:8089/ws
# NOTE: there is deliberately no CAMPAIGN_AGENT_QUEUE setting any more. A single queue name in
# config meant every client's agents shared one queue, so one client's caller could be answered by
# another client's agent. Each client now has their own queue (tenants.agent_queue_name -> the
# realtime `queues` table), created automatically at onboarding, and the name is resolved per call
# by backend/services/tenantQueueService.js. Nothing about it is configurable per deployment.

# Asterisk ARI (Workstream 8 - IVR flow engine). Reuses the same TLS port/cert as
# ASTERISK_WSS_URL above (8089) - confirmed already reachable externally, no separate
# security-group port needed. See ari.conf's [ivr_engine] user block on the EC2 box.
# IMPORTANT: must use the box's cert-matching hostname (its SAN, e.g. an *.sslip.io name for
# the EC2 IP), not the bare IP - confirmed live that a raw-IP URL fails TLS hostname
# verification even though the same box/port answers fine.
ARI_BASE_URL=https://127.0.0.1:8089
ARI_USERNAME=ivr_engine
ARI_PASSWORD=change_me
ARI_APP_NAME=ivr_engine
# Set to true only for local dev without a real Asterisk box. Never set true in production.
ARI_MOCK_MODE=false

# Piper TTS (Workstream 8.9) - offline, local neural TTS, required for any IVR flow
# 'play'/'menu'/etc. node whose prompt_id contains {{variable}} placeholders (e.g. speaking
# back a looked-up provider name or generated booking code). Static, pre-recorded prompts don't
# need this at all. Runs ON the Asterisk box (not Render) over its OWN dedicated SSH credential -
# deliberately separate from ASTERISK_SSH_* above, since that account is SFTP-only (shell is
# nologin) and cannot exec anything. This user must be restricted to running only the Piper
# wrapper (a forced `command=` entry in its authorized_keys), same least-privilege principle as
# campaign-uploader. Already set up on the EC2 box: Piper installed at /opt/piper, three voice
# models in PIPER_MODEL_DIR, and the tts-runner user/wrapper below.
#
# Two ways to supply the private key - PIPER_SSH_PRIVATE_KEY_B64 is strongly preferred:
#   PREFERRED: PIPER_SSH_PRIVATE_KEY_B64 - the key, base64-encoded onto ONE line
#     (`base64 -w0 tts_runner_key`), set as a normal env var. A multi-line PEM block pasted into
#     a dashboard's Secret File editor is easy to silently corrupt (dropped newline, trailing
#     whitespace, truncated paste) with no error anywhere until the SSH handshake fails - hit
#     this repeatedly in practice. A single-line value is far harder for a UI paste to mangle.
#   FALLBACK: PIPER_SSH_PRIVATE_KEY_PATH - path to a mounted Secret File containing the raw key.
#     Only used if PIPER_SSH_PRIVATE_KEY_B64 is unset.
PIPER_SSH_HOST=127.0.0.1
PIPER_SSH_PORT=22
PIPER_SSH_USER=tts-runner
PIPER_SSH_PRIVATE_KEY_B64=
PIPER_SSH_PRIVATE_KEY_PATH=/etc/secrets/tts_runner_key
PIPER_BIN=piper
PIPER_MODEL_DIR=/opt/piper/models
# Piper has no en-IN voice - en_US-lessac-medium is the installed default/fallback.
PIPER_DEFAULT_MODEL=en_US-lessac-medium.onnx
# Per-language override as a JSON object - these three models are the ones actually installed
# in PIPER_MODEL_DIR on the EC2 box (see Workstream 8.9 setup notes).
PIPER_VOICE_MODELS={"en-US":"en_US-lessac-medium.onnx","hi-IN":"hi_IN-priyamvada-medium.onnx","mr-IN":"mr_IN-google-medium.onnx"}
TTS_DEFAULT_LANGUAGE_CODE=en-US
# Naturalness tuning passed to every `piper` invocation - defaults below are already a step up
# from Piper's own library defaults (0.667 / 0.8 / 1.0), which read as flat/robotic. Raise
# PIPER_NOISE_W further for more natural timing variance, or PIPER_LENGTH_SCALE above 1.0 to
# slow the pace down (e.g. 1.1 for a calmer-sounding IVR prompt).
PIPER_NOISE_SCALE=0.72
PIPER_NOISE_W=0.92
PIPER_LENGTH_SCALE=1.0
# Per-language override on top of the above - hi_IN-priyamvada is trained on less data than the
# English voices and reads flatter at the same noise_w, so it's nudged higher by default in
# ttsService.js (noiseScale 0.78 / noiseW 1.05) without needing this var set at all. Only set
# PIPER_LANGUAGE_TUNING if you want to override that further, e.g.:
#   PIPER_LANGUAGE_TUNING={"hi-IN":{"noiseW":"1.1"},"mr-IN":{"noiseW":"1.0"}}

# Shared secret required on the handful of endpoints Asterisk's dialplan calls directly via
# CURL() (currently /api/campaigns/optout) - these can't carry a JWT, so this is their only real
# gate. Soft-enforced: if unset, those endpoints stay reachable (loudly logged as unauthenticated)
# rather than breaking a live dialplan that hasn't been updated yet - see middleware/webhookAuth.js.
# To actually enforce: set this to a long random value here AND add &secret=<same value> to the
# matching CURL() call(s) in telephony_config/extensions.conf on the Asterisk box.
CAMPAIGN_WEBHOOK_SECRET=

# Dinstar GSM gateway
DINSTAR_GATEWAY_IP=192.168.1.186
DINSTAR_API_USER=change_me
DINSTAR_API_PASS=change_me

# Campaign dialer pacing (minimum stagger between originates, seconds)
PACING_BUFFER_DELAY_SEC=2
# How long an ordinary (non-transferred) answered call may hold its concurrency slot, ms.
MAX_CALL_DURATION_MS=300000
# Workstream 7: how long a call TRANSFERRED to a live agent (DTMF 1) may hold its slot, ms -
# must be long enough for a real conversation, unlike MAX_CALL_DURATION_MS above.
MAX_AGENT_CALL_DURATION_MS=7200000
# How many times a lead is retried after an immediate gateway-busy rejection before failing it.
MAX_DIAL_ATTEMPTS=3

# SSH/SCP delivery of transcoded campaign audio to the Asterisk box's sounds directory
ASTERISK_SSH_HOST=127.0.0.1
ASTERISK_SSH_PORT=22
ASTERISK_SSH_USER=campaign-uploader
ASTERISK_SSH_PRIVATE_KEY_PATH=/etc/secrets/asterisk_deploy_key
# campaign-uploader is chrooted to /var/lib/asterisk/sounds (see README deploy runbook),
# so this path is relative to THAT root, not the Asterisk host's real filesystem root.
ASTERISK_SOUNDS_DIR=/campaign_audio

S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Structured logging (pino) - one of fatal/error/warn/info/debug/trace. Defaults to info.
LOG_LEVEL=info

# Optional error tracking - inert/no-op if unset. Set to a real Sentry project DSN to start
# reporting uncaught exceptions and worker-loop errors (see utils/sentry.js).
SENTRY_DSN=
